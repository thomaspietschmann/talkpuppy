<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer stops device-to-device
     transfer. Recordings, transcripts and models must never leave the
     phone, so every domain is excluded from both cloud backup and device
     transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
